{
  "name": "dsh-mcp-tavily",
  "version": "1.2.1",
  "private": false,
  "type": "module",
  "description": "Tavily web search for DeepSeek Harness (dsh): a Tavily search provider with a visual API-key card, plus a bridge to Tavily's hosted remote MCP server",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "tavily",
    "mcp",
    "web-search",
    "grounding"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wjh-ux/dsh-mcp-tavily.git"
  },
  "homepage": "https://github.com/wjh-ux/dsh-mcp-tavily#readme",
  "bugs": {
    "url": "https://github.com/wjh-ux/dsh-mcp-tavily/issues"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-credentials": ">=0.1.5-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-launch-environment": ">=0.1.5-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-web": ">=0.1.5-rc.2 <0.3.0-0"
  }
}
